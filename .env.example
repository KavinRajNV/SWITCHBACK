# ---------------------------------------------------------------------------
# Switchback backend configuration. Copy to `.env`. Every value is optional
# except the database — and even that defaults to the bundled offline snapshot.
# ---------------------------------------------------------------------------

# Database. Leave BLANK to use the local offline MongoDB started by
# `docker compose up -d` (mongodb://localhost:27017). Set it to an Atlas/self
# -hosted URI to use your own instead.
MONGODB_URI=
MONGO_DB_NAME=switchback

# App environment: "development" surfaces error detail in API 500s; anything
# else hides it.
APP_ENV=development

# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Optional live integrations (all degrade gracefully when unset) ---------
# Live job-market strip on the dashboard.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Higher rate limit for GitHub skill verification (a classic PAT, no scopes needed).
GITHUB_TOKEN=
# Free YouTube video suggestions on learning-path milestones.
YOUTUBE_API_KEY=

# --- Optional LLM assist ---------------------------------------------------
# Used ONLY to phrase/route the conversational assistant and goal parser when
# the deterministic path is unsure. Never a source of facts. Unset = fully
# deterministic.
NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-20b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT_SECONDS=30
